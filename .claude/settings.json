{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "~/.claude/idx-block.sh" }]
      },
      {
        "matcher": "Read",
        "hooks": [{ "type": "command", "command": "~/.claude/idx-read-block.sh" }]
      },
      {
        "matcher": "Grep",
        "hooks": [{ "type": "command", "command": "~/.claude/idx-grep-block.sh" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "~/.claude/idx-context-hook.sh" }]
      }
    ]
  },
  "permissions": { "allow": [] }
}
